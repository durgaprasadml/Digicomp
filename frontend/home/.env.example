# DigiComp AI Assistant API Endpoint
# Default local FastAPI backend URL
VITE_AI_API_URL=http://127.0.0.1:8000
VITE_AI_TIMEOUT_SECONDS=120

# Google OAuth Sign-In (optional - enable Google Sign-In)
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client ID)
VITE_GOOGLE_CLIENT_ID=

# SMS Provider for Phone OTP (optional - backend env or wp-config.php)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

